# Copie para .env e ajuste conforme necessário.

# --- Banco de dados (SQLite em arquivo — suficiente pro MVP/dev) ---
DATABASE_URL=sqlite:////app/data/app.db

# --- Redis (fila do Celery) ---
# Localmente (fora do docker-compose) use redis://localhost:6379/0.
# Dentro do docker-compose, REDIS_URL já é sobrescrita para redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0

# --- Whisper (faster-whisper, CPU) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Config default de corte ---
DEFAULT_MAX_CLIPS=3
DEFAULT_CLIP_DURATION_MIN=15
DEFAULT_CLIP_DURATION_MAX=60

MAX_UPLOAD_SIZE_GB=5

# --- YouTube Data API v3 (opcional — habilita sync automático de métricas) ---
# Crie uma API key simples em console.cloud.google.com (sem OAuth, sem app review).
YOUTUBE_API_KEY=
